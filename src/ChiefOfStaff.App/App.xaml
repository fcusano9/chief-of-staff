<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ChiefOfStaff.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- One task row: project-colored stripe, priority badge, title, optional project chip, due date. -->
            <DataTemplate x:Key="TaskRowTemplate">
                <Grid Padding="0,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding StripeBrush}" CornerRadius="2" />
                    <Border Grid.Column="1" Background="{Binding ScoreBackground}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" MinWidth="36">
                        <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreForeground}" FontSize="12" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Rationale}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{Binding ProjectChipBackground}" Visibility="{Binding ProjectVisibility}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectName}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding DueText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
