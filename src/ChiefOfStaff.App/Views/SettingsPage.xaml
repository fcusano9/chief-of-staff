<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChiefOfStaff.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="900">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="AI providers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Claude (Anthropic API) is added in the next milestone, along with a place to store your API key securely in Windows Credential Manager. Microsoft 365 Copilot needs an Entra app registration from Crestron IT." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Priority weights" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="How much each signal counts toward a task's 0-100 priority score. Changes apply to all open tasks when you save." />
                    <Slider x:Name="DueWeight" Header="Due dates and deadlines" Minimum="0" Maximum="10" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" />
                    <Slider x:Name="RequesterWeight" Header="Who is asking" Minimum="0" Maximum="10" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" />
                    <Slider x:Name="StaleWeight" Header="Staleness and follow-ups" Minimum="0" Maximum="10" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Save weights" Style="{StaticResource AccentButtonStyle}" Click="SaveWeights_Click" />
                        <TextBlock x:Name="WeightsStatus" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Your live data stays on this PC. A snapshot is copied to the backup folder once a day when the app starts." />
                    <TextBox x:Name="BackupFolderBox" Header="Backup folder" />
                    <NumberBox x:Name="KeepBox" Header="Backups to keep" Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Click="SaveBackup_Click" />
                        <Button Content="Back up now" Click="BackupNow_Click" />
                        <Button Content="Open backup folder" Click="OpenBackupFolder_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackupStatus" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
