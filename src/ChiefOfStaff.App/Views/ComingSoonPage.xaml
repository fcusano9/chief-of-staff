<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChiefOfStaff.App.Views.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="32,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        <InfoBar x:Name="MilestoneBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Coming soon" />
    </StackPanel>
</Page>
