<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChiefOfStaff.App.Views.WaitingOnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24" RowSpacing="8" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Waiting on others" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource MutedTextStyle}"
                   Text="Tasks set to Waiting on, oldest first. AI-drafted follow-ups arrive with the AI features; drafts are never sent without you." />
        <Grid Grid.Row="2">
            <ListView x:Name="WaitingList" IsItemClickEnabled="True" ItemClick="Task_ItemClick" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding StripeBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding WaitingBackground}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WaitingDaysText}" FontSize="12" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" Text="Nothing is waiting on anyone right now." />
        </Grid>
    </Grid>
</Page>
