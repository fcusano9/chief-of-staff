<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChiefOfStaff.App.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Grid>
                <TextBlock x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="NewTask_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New task" /></StackPanel>
                    </Button>
                    <Button Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SubGreeting" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,12" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="Urgent" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="UrgentCount" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="Open tasks" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="OpenCount" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="Waiting on" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="WaitingCount" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="Overdue" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="OverdueCount" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Focus on these first" Style="{StaticResource SectionHeaderStyle}" />
            <ListView x:Name="FocusList" ItemTemplate="{StaticResource TaskRowTemplate}" IsItemClickEnabled="True" ItemClick="Task_ItemClick" SelectionMode="None" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"
                       Text="You have no open tasks. Add one with New task, or import your Copilot summary once AI is connected." />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE787;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="AI briefing and next meeting" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="The AI-written morning briefing and meeting prep appear here once an AI provider and Outlook are connected. Priorities above are already calculated from due dates, who's asking, and staleness." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
