<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChiefOfStaff.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="8" MaxWidth="1000">
            <Grid>
                <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="NewProject_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New project" /></StackPanel>
                </Button>
            </Grid>

            <GridView x:Name="ProjectGrid" SelectionMode="Single" SelectionChanged="ProjectGrid_SelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <StackPanel Spacing="6">
                                <Border Height="4" CornerRadius="2" Background="{Binding ColorBrush}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding OpenText}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"
                       Text="Create a project for each workstream. Tasks in a project take on its color, and the AI reads the project brief whenever it works on those tasks." />

            <Border x:Name="DetailCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,8,0,0">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DetailStripe" Width="6" CornerRadius="3" />
                        <TextBox x:Name="NameBox" Grid.Column="1" PlaceholderText="Project name" FontSize="18" />
                        <ComboBox x:Name="StatusBox" Grid.Column="2" Width="150">
                            <x:String>Active</x:String>
                            <x:String>On hold</x:String>
                            <x:String>Completed</x:String>
                            <x:String>Archived</x:String>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl x:Name="ColorPicker">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="{Binding Brush}" BorderThickness="{Binding Border}"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" Tag="{Binding Hex}" Click="Color_Click"
                                        ToolTipService.ToolTip="{Binding Hex}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Project brief" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Goals, background, key decisions with dates, stakeholders, timeline, and open questions. The AI reads this every time it works on a task in this project, and will propose updates as new information arrives." />
                    <TextBox x:Name="BriefSummaryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                             PlaceholderText="Goal: ...&#x0a;Key decisions: ...&#x0a;Stakeholders: ...&#x0a;Open questions: ..." />
                    <TextBox x:Name="BriefInstructionsBox" Header="Your standing instructions" AcceptsReturn="True" TextWrapping="Wrap"
                             PlaceholderText="VP prefers one-page summaries. Always cc my manager on roadmap emails." />
                    <TextBlock x:Name="BriefUpdatedText" Style="{StaticResource MutedTextStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <Button Content="New task in this project" Click="NewTask_Click" />
                        <Button x:Name="DeleteButton" Content="Delete project" Click="Delete_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" />

                    <TextBlock Text="Open tasks" Style="{StaticResource SectionHeaderStyle}" />
                    <ListView x:Name="ProjectTasks" ItemTemplate="{StaticResource TaskRowTemplate}" IsItemClickEnabled="True" ItemClick="Task_ItemClick" SelectionMode="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
