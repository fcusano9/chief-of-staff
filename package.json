{
  "name": "chief-of-staff",
  "productName": "Chief of Staff",
  "version": "1.0.0",
  "description": "AI-assisted work manager. The AI proposes; you decide.",
  "author": "Frank Cusano",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "demo:data": "electron-vite build && node scripts/demo-data.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "e2e": "electron-vite build && node e2e/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "bench:ai": "vitest run --config bench/vitest.config.ts",
    "install:win": "electron-vite build && electron-builder --win --dir \"-c.directories.output=%LOCALAPPDATA%/Programs/Chief of Staff (build)\"",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
